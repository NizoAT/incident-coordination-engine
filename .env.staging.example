# Staging: pull GHCR (M16). Copier vers .env.staging :
#   cp .env.staging.example .env.staging

# Image publiée par le workflow CD (branche main ou tag semver)
ICE_IMAGE=ghcr.io/nizoat/incident-coordination-engine:main

# Secrets obligatoires (ne jamais committer .env.staging)
SESSION_SECRET=change-me-minimum-32-characters!!
GITHUB_WEBHOOK_SECRET=change-me-github-webhook-secret

# Optionnel
NGINX_PORT=8080
SLA_TICK_INTERVAL_MS=30000
