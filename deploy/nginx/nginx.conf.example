# ICE: reverse proxy Nginx (M12)
#
# Template de référence: en runtime Compose, les fichiers actifs sont :
#   deploy/nginx/conf.d/00-upgrade-map.conf
#   deploy/nginx/conf.d/ice.conf
#
# Copiez ou adaptez ces fichiers pour votre environnement (TLS terminé en amont
# ou via un second server {} sur 443: hors scope portfolio M12).

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

upstream ice_app {
    server web:3001;
    keepalive 16;
}

server {
    listen 80;
    server_name _;

    # Headers sécurité (patterns prod sanitisés)
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-XSS-Protection "0" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

    client_max_body_size 4m;

    location = /nginx-health {
        access_log off;
        return 200 "ok\n";
        add_header Content-Type text/plain;
    }

    # Webhook GitHub: body brut pour validation HMAC
    location /api/webhooks/ {
        proxy_pass http://ice_app;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        client_max_body_size 1m;
        proxy_request_buffering off;
    }

    location / {
        proxy_pass http://ice_app;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_connect_timeout 10s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
        proxy_buffering off;
    }
}

# TLS local (optionnel: commentaire pour extension prod) :
# server {
#     listen 443 ssl http2;
#     ssl_certificate     /etc/nginx/certs/fullchain.pem;
#     ssl_certificate_key /etc/nginx/certs/privkey.pem;
#     include             /etc/nginx/conf.d/ice.conf;  # ou dupliquer le bloc location
# }
